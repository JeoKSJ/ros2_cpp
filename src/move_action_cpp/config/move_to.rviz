Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Marker
      Name: MoveTo Feedback
      Enabled: true
      Topic:
        Value: /move_to_marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Global Options:
    Fixed Frame: world
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 34
      Focal Point:
        X: 8
        Y: 4
        Z: 0
      Pitch: 0.65
      Yaw: 0.85
